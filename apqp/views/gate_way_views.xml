<odoo>

    <!-- Gate Form -->
    <record id="view_gate_review_form" model="ir.ui.view">
        <field name="name">gate.review.form</field>
        <field name="model">gate.review</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <notebook>
                        <page string="Points">
                            <field name="point_ids">
                                <list editable="bottom">
                                    <field name="point_id"/>
                                    <field name="department_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Point Master -->
    <record id="view_gate_point_master_list" model="ir.ui.view">
        <field name="name">gate.point.master.list</field>
        <field name="model">gate.point.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_gate_point_master_form" model="ir.ui.view">
        <field name="name">gate.point.master.form</field>
        <field name="model">gate.point.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_gate_review" model="ir.actions.act_window">
        <field name="name">Gate Review</field>
        <field name="res_model">gate.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gate_point_master" model="ir.actions.act_window">
        <field name="name">Point Master</field>
        <field name="res_model">gate.point.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
     <menuitem id="menu_gate_review"
          name="Gate Review"
          parent="apqp.menu_apqp_configuration"
          action="action_gate_review"
          sequence="60"/>

</odoo>
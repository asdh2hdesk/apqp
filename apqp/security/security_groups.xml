<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_apqp_user" model="res.groups">
        <field name="name">APQP User</field>
        <field name="category_id" ref="xf_doc_approval.module_category_xf_doc_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_apqp_manager" model="res.groups">
        <field name="name">APQP Manager</field>
        <field name="category_id" ref="xf_doc_approval.module_category_xf_doc_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_apqp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
